{
  "name": "rayahoosh",
  "version": "1.0.0",
  "description": "Rayahoosh Desktop App",
  "author": "Arshiya",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rayahoosh.app",
    "productName": "Rayahoosh",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.png",
      "artifactName": "Rayahoosh-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rayahoosh",
      "installerIcon": "icon.png",
      "uninstallerIcon": "icon.png"
    }
  }
}
